PORT=8000
NODE_ENV=development
# Frontend URL(s) allowed to call the API, comma separated.
# Required in production. In development, localhost is allowed if this is empty.
CORS_ORIGIN=http://localhost:5173

# Quereo's own data (users, connections, monitors). Use your MongoDB Atlas URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Any long random string
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d

# 64 hex characters (32 bytes). Encrypts saved database passwords.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional: enables AI explain and natural language to SQL (https://console.groq.com/keys)
GROQ_API_KEY=
# Available on Groq's standard plans; supports strict JSON output
GROQ_MODEL=openai/gpt-oss-120b

# Optional: enables "Continue with Google" (https://console.cloud.google.com/apis/credentials)
# Create an OAuth client of type "Web application" and add your frontend URL
# (e.g. http://localhost:5173) to its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
